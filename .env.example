NODE_ENV=development
PORT=3000
BASE_PATH=/store
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://store_user:store_password@localhost:3306/university_store
JWT_SECRET=replace-with-at-least-32-random-characters
DEV_LOGIN_ENABLED=true

# Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_AUDIENCE=

# Azure Key Vault (production)
KEY_VAULT_URL=
# Optional Key Vault secret names (hyphens are required by Azure naming rules)
KEY_VAULT_DATABASE_SECRET=database-url
KEY_VAULT_JWT_SECRET=jwt-secret
KEY_VAULT_OPENAI_SECRET=openai-api-key
KEY_VAULT_PARTNER_SECRET=partner-api-key
KEY_VAULT_EXPOSED_PEER_SECRET=exposed-peer-api-key

# AI product description
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Peer API
PARTNER_API_BASE_URL=
PARTNER_API_KEY=
EXPOSED_PEER_API_KEY=replace-with-a-different-random-key
